# Copy to .env.local and fill in. .env.local is gitignored - never commit it.

# ---- Public (embedded in the client bundle, safe to expose but still
#      restrict the Google key by HTTP referrer in Cloud Console) ----
NEXT_PUBLIC_API_URL=https://api.thepdfninja.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# ---- Server-only, used by app/api/complaint/route.ts ----
# Set these in the Vercel dashboard for production; never in a committed file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
COMPLAINT_TO_EMAIL=
